{
    "manifest_version": 3,
    "default_locale": "en",
    "name": "__MSG_name__",
    "version": "0.1.0",
    "description": "__MSG_description__",
    "permissions": [
        "contextMenus",
        "nativeMessaging",
        "cookies",
        "storage",
        "webRequest",
        "scripting"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "scripts": [
            "background/core.js",
            "background/native.js",
            "background/remote.js",
            "background/status.js",
            "background/copies.js",
            "background/rules.js",
            "background/requests.js",
            "background/tab-media.js",
            "background/cookies.js",
            "background/proxy.js",
            "background/capture.js",
            "background/opened.js",
            "background/firefox-answers.js",
            "background/menus.js",
            "background/start.js",
            "background/messages.js",
            "background/lookup.js",
            "background/played.js",
            "background/panel.js",
            "background/main.js"
        ],
        "persistent": false
    },
    "action": {
        "default_title": "__MSG_name__",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "24": "icons/icon-24.png",
            "32": "icons/icon-32.png"
        }
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "video.js"
            ],
            "all_frames": true,
            "run_at": "document_idle"
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "page.js"
            ],
            "all_frames": true,
            "run_at": "document_start"
        }
    ],
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "browser_specific_settings": {
        "safari": {
            "strict_min_version": "17.0"
        }
    }
}
