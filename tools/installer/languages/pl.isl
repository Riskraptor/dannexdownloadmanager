[CustomMessages]
;en TaskBrowser=Set up &browser integration (Chrome, Edge, Brave, Firefox)
TaskBrowser=Skonfiguruj integrację z &przeglądarką (Chrome, Edge, Brave, Firefox)
;en TaskTorrents=Open .&torrent files and magnet links with {#AppName}
TaskTorrents=Otwieraj pliki .&torrent i linki magnet za pomocą Dannex Download Manager
;en TaskStartup=Start {#AppName} when &Windows starts
TaskStartup=Uruchamiaj Dannex Download Manager przy starcie systemu &Windows
;en ChoicesTitle=A few choices
ChoicesTitle=Kilka opcji
;en ChoicesDesc={#AppName} can set these up for you.
ChoicesDesc=Dannex Download Manager może to za ciebie skonfigurować.
;en ChoicesLabel=Tick what you want, then click %1.
ChoicesLabel=Zaznacz, co chcesz, a następnie kliknij przycisk %1.
;en ToolsLater=Some parts will finish setting up the next time you're online.
ToolsLater=Konfiguracja niektórych elementów zostanie dokończona, gdy następnym razem połączysz się z internetem.
;en Launch=Start {#AppName}
Launch=Uruchom Dannex Download Manager
;en AddExtension=Add {#AppName} to my &browser
AddExtension=Dodaj Dannex Download Manager do mojej &przeglądarki
;en KeepData=Also delete your download list and settings?%n%nYour downloaded files are not touched either way.
KeepData=Czy usunąć również listę pobierania i ustawienia?%n%nPobrane pliki nie zostaną naruszone.
